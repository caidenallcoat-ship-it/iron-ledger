{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/notify",
      "schedule": "0 20 * * *"
    }
  ]
}
